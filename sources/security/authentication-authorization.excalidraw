    },
    {
      "id": "Boncfduyd6uyk8sa8zU1H",
      "type": "text",
      "x": -1232.6597010815956,
      "y": 529.6623703936184,
      "width": 345.5,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aOO",
      "roundness": null,
      "seed": 322180942,
      "version": 589,
      "versionNonce": 592580773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795580924299,
      "created": 1795077323487,
      "link": null,
      "locked": false,
      "text": "기간 설정 가능\n로컬 저장소에 저장\n서버에서 제공하면 자동으로 헤더에 첨부\n4kb 제한 문자열\n항상 쿠키 전체 전송\n이벤트 없음\n플래그로 CSRF, XSS 등 방지 가능",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "w57ThepwYDVtd4LJOBG7J",
      "originalText": "기간 설정 가능\n로컬 저장소에 저장\n서버에서 제공하면 자동으로 헤더에 첨부\n4kb 제한 문자열\n항상 쿠키 전체 전송\n이벤트 없음\n플래그로 CSRF, XSS 등 방지 가능",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "tdTZ2KHSpt4MCBkd8QbEB",
      "type": "rectangle",
      "x": 79.14871431354209,
      "y": 580.6505109512868,
      "width": 644.6038723347247,
      "height": 200.2014532596632,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
