      "locked": false
    },
    {
      "id": "WV30OCtroPg5dUepLsUCK",
      "type": "text",
      "x": 84.14871431354209,
      "y": 650.85196421095,
      "width": 620.8800048828125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aOdV",
      "roundness": null,
      "seed": 1518785962,
      "version": 713,
      "versionNonce": 1923597174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795157800283,
      "created": 1795156848171,
      "link": null,
      "locked": false,
      "text": "- 서버의 DB에서 관리하는 고유한 ID인 세션ID를 클라이언트에게 제공\n- 서버가 세션ID를 Key로 저장하고, 그 외 정보를 Value로 저장하는 K-V\n구조\n- 매번 서버 DB서버에 확인 요청을 날려야 하므로 서버에 부하를 일으킴\n(Stateful)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "bottom",
      "containerId": "tdTZ2KHSpt4MCBkd8QbEB",
      "originalText": "- 서버의 DB에서 관리하는 고유한 ID인 세션ID를 클라이언트에게 제공\n- 서버가 세션ID를 Key로 저장하고, 그 외 정보를 Value로 저장하는 K-V 구조\n- 매번 서버 DB서버에 확인 요청을 날려야 하므로 서버에 부하를 일으킴(Stateful)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4AXKo4YaL1Qbc_ptn0CHE",
      "type": "rectangle",
